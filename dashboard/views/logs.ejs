<%- include('partials/header') %>
<div class="page-header">
  <div>
    <h1>📋 Verification Logs</h1>
    <div class="subtitle">Last 200 verification records</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>📜 Log History</h2>
    <span class="badge badge-orange"><%= logs.length %> records</span>
  </div>
  <div class="card-body" style="padding:0">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Target</th><th>Verified By</th><th>Gender</th><th>Answer</th><th>Notes</th><th>Risk</th><th>DM</th></tr></thead>
        <tbody>
          <% logs.forEach(l => { %>
            <tr>
              <td style="white-space:nowrap;font-size:0.75rem"><%= l.verifiedAt ? new Date(l.verifiedAt).toLocaleString() : '-' %></td>
              <td><span class="truncate" style="display:block;max-width:120px"><%= l.targetTag || l.targetId || '-' %></span></td>
              <td><span class="truncate" style="display:block;max-width:120px"><%= l.verifierTag || l.verifierId || '-' %></span></td>
              <td><%= l.gender || '-' %></td>
              <td><%= l.staffAnswer || '-' %></td>
              <td><span class="truncate" style="display:block;max-width:150px"><%= (l.notes || '-').slice(0, 60) %></span></td>
              <td><%= l.riskLevel ? `<span class="badge badge-${l.riskLevel === 'HIGH' ? 'red' : 'green'}">${l.riskLevel}</span>` : '-' %></td>
              <td><%= l.dmSent ? '✅' : '❌' %></td>
            </tr>
          <% }) %>
          <% if (logs.length === 0) { %><tr><td colspan="8"><div class="empty-state"><div class="empty-icon">📋</div>No logs recorded yet</div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
