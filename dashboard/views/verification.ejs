<%- include('partials/header') %>
<div class="page-header">
  <div>
    <h1>✅ Verification</h1>
    <div class="subtitle">Verify users, manage blacklist, track stats</div>
  </div>
</div>

<% if (query.msg) { %><div class="alert alert-success"><%= query.msg %></div><% } %>
<% if (query.error) { %><div class="alert alert-error"><%= query.error %></div><% } %>

<div class="stats-grid">
  <div class="stat-card"><div class="stat-value"><%= Object.keys(counter).length %></div><div class="stat-label">Verifiers</div></div>
  <div class="stat-card"><div class="stat-value"><%= totalVerifications %></div><div class="stat-label">Total Verified</div></div>
  <div class="stat-card"><div class="stat-value"><%= blacklist.length %></div><div class="stat-label">Blacklisted</div></div>
  <div class="stat-card"><div class="stat-value"><%= history.length %></div><div class="stat-label">History Records</div></div>
</div>

<!-- Settings -->
<div class="card">
  <div class="card-header" onclick="this.parentElement.classList.toggle('collapsed')">
    <h2>⚙️ Settings</h2>
    <span class="badge badge-blue"><%= Object.keys(verEnv).length %> fields</span>
  </div>
  <div class="card-body">
    <form method="POST" action="/verification/save" class="form-grid">
      <% Object.entries(verEnv).forEach(([k, v]) => { %>
        <div class="form-group">
          <label><%= k %></label>
          <input type="text" name="<%= k %>" value="<%= v %>" placeholder="<%= k %>">
        </div>
      <% }) %>
      <div class="form-actions" style="grid-column:1/-1">
        <button type="submit" class="btn btn-primary">💾 Save Settings</button>
      </div>
    </form>
  </div>
</div>

<!-- Blacklist -->
<div class="card">
  <div class="card-header" onclick="this.parentElement.classList.toggle('collapsed')">
    <h2>🚫 Blacklist</h2>
    <span class="badge badge-red"><%= blacklist.length %></span>
  </div>
  <div class="card-body">
    <form method="POST" action="/verification/blacklist/add" class="form-row mb-2">
      <div class="form-group">
        <label>User ID</label>
        <input type="text" name="userId" placeholder="Discord User ID" required>
      </div>
      <div class="form-group">
        <label>Reason</label>
        <input type="text" name="reason" placeholder="Why is this user blacklisted?">
      </div>
      <button type="submit" class="btn btn-danger">➕ Add to Blacklist</button>
    </form>

    <div class="table-wrap">
      <table>
        <thead><tr><th>User ID</th><th>Reason</th><th>Moderator</th><th>Date</th><th>Action</th></tr></thead>
        <tbody>
          <% blacklist.forEach(b => { %>
            <tr>
              <td><code><%= b.id %></code></td>
              <td><span class="truncate" style="display:block"><%= b.reason || '-' %></span></td>
              <td><%= b.moderatorId || '-' %></td>
              <td><%= b.createdAt ? new Date(b.createdAt).toLocaleDateString() : '-' %></td>
              <td>
                <form method="POST" action="/verification/blacklist/remove" style="display:inline">
                  <input type="hidden" name="userId" value="<%= b.id %>">
                  <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (blacklist.length === 0) { %><tr><td colspan="5"><div class="empty-state"><div class="empty-icon">✅</div>No blacklisted users</div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Verifier Stats -->
<div class="card">
  <div class="card-header" onclick="this.parentElement.classList.toggle('collapsed')">
    <h2>📊 Verifier Leaderboard</h2>
    <span class="badge badge-green"><%= Object.keys(counter).length %> verifiers</span>
  </div>
  <div class="card-body">
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Verifier ID</th><th>Verifications</th></tr></thead>
        <tbody>
          <% Object.entries(counter).sort((a,b) => b[1]-a[1]).forEach(([id, count], i) => { %>
            <tr><td><%= i+1 %></td><td><code><%= id %></code></td><td><strong><%= count %></strong></td></tr>
          <% }) %>
          <% if (Object.keys(counter).length === 0) { %><tr><td colspan="3"><div class="empty-state"><div class="empty-icon">📊</div>No verification data yet</div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Recent History -->
<div class="card">
  <div class="card-header" onclick="this.parentElement.classList.toggle('collapsed')">
    <h2>📜 Recent History</h2>
    <span class="badge badge-orange">Last 50</span>
  </div>
  <div class="card-body">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Target</th><th>Verifier</th><th>Gender</th><th>Answer</th></tr></thead>
        <tbody>
          <% history.slice(-50).reverse().forEach(l => { %>
            <tr>
              <td><%= l.verifiedAt ? new Date(l.verifiedAt).toLocaleString() : '-' %></td>
              <td><span class="truncate" style="display:block"><%= l.targetTag || l.targetId %></span></td>
              <td><span class="truncate" style="display:block"><%= l.verifierTag || l.verifierId %></span></td>
              <td><%= l.gender || '-' %></td>
              <td><%= l.staffAnswer || '-' %></td>
            </tr>
          <% }) %>
          <% if (history.length === 0) { %><tr><td colspan="5"><div class="empty-state"><div class="empty-icon">📜</div>No history yet</div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
